@import '../../../../styles/vars.styl'

// Normal size media item
.mediaItem
  width 100%
  min-height 270px
  border-radius var(--border-radius-large)
  overflow hidden
  background linear-gradient(135deg, rgba(122, 122, 122, 0.07), rgba(0, 0, 0, 0))

  @media (min-width $mobile-width)
    min-height 380px

.video
  width 100%
  height 100%
  object-fit cover

.photo
  width 100%
  height 100%
  object-fit cover

.placeholder
  width 100%
  height 100%
  background linear-gradient(135deg, rgba(122, 122, 122, 0.07), rgba(0, 0, 0, 0))

// Small size media item
.smallMediaItem
  width 100%
  aspect-ratio 1
  border-radius var(--border-radius-medium)
  overflow hidden
  background linear-gradient(135deg, rgba(122, 122, 122, 0.07), rgba(0, 0, 0, 0))
