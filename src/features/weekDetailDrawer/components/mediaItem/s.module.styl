@import '../../../../styles/vars.styl'

// Normal size media item
.mediaItem
  width 100%
  min-height 270px
  border-radius var(--border-radius-large) var(--border-radius-large) 0 0
  overflow hidden
  background var(--shading-color)
  transition background 0.2s ease

  &:hover
    background transparent

  @media (min-width $mobile-width)
    min-height 380px

.video
  width 100%
  height 100%
  object-fit cover

.photo
  width 100%
  height 100%
  object-fit cover

.placeholder
  width 100%
  height 100%
  display flex
  align-items center
  justify-content center
  position relative
  flex-direction column
  margin-top 5px

  &:hover
    cursor default

  .placeholderIcon
    font-size 42px
    line-height 50px
    font-weight 100
    color var(--text-color)
    transition font-size 0.2s ease
    opacity 0.8

  &:hover
    .placeholderIcon
      font-size 50px
      cursor default
      opacity 1

.smallMediaItem .placeholder
  .placeholderIcon
    font-size 18px
    font-weight 100
    line-height 24px
    opacity 0.8

  &:hover
    .placeholderIcon
      font-size 24px
      cursor default
      opacity 1

.dayLabel
  font-size 10px
  font-weight 100
  color var(--disabled-color)
  line-height 1
  opacity 0.7
  transition font-size 0.2s ease

  &:hover
    cursor default
    opacity 1

// Small size media item
.smallMediaItem
  width 100%
  min-height 60px
  overflow hidden
  border-radius 0

  &.first
    border-bottom-left-radius var(--border-radius)

  &.last
    border-bottom-right-radius var(--border-radius)

  @media (min-width $mobile-width)
    min-height 80px