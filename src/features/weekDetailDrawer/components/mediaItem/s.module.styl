@import '../../../../styles/vars.styl'

// Normal size media item
.mediaItem
  width 100%
  min-height 270px
  border-radius var(--border-radius-large) var(--border-radius-large) 0 0
  overflow hidden
  background var(--shading-color)
  transition background 0.2s ease

  &:hover
    background transparent

  @media (min-width $mobile-width)
    min-height 380px

.bottomRadius
  border-bottom-left-radius var(--border-radius-large)
  border-bottom-right-radius var(--border-radius-large)

.video
  width 100%
  height 100%
  object-fit cover
  cursor pointer
  transition transform 0.2s ease

  &:hover
    transform scale(1.02)

.photo
  width 100%
  height 100%
  object-fit cover
  cursor pointer
  transition transform 0.2s ease

  &:hover
    transform scale(1.02)

.placeholder
  width 100%
  height 100%
  display flex
  align-items center
  justify-content center
  position relative
  flex-direction column
  margin-top 5px
  overflow hidden

  &:hover
    cursor default

  .placeholderIcon
    font-size 42px
    line-height 50px
    font-weight 100
    color var(--text-color)
    transition font-size 0.2s ease
    opacity 0.8

  &:hover
    .placeholderIcon
      font-size 50px
      cursor default
      opacity 1

// Skeleton animation styles
.skeleton
  position absolute
  top 0
  left 0
  right 0
  bottom 0
  background linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent)
  background-size 200% 100%
  animation skeleton-shimmer 1.5s infinite
  pointer-events none

.skeletonActive
  .placeholderIcon
    opacity 0.3 !important
    font-size 42px !important

  .dayLabel
    opacity 0.3 !important

@keyframes skeleton-shimmer
  0%
    background-position -200% 0

  100%
    background-position 200% 0

.dayLabel
  font-size 10px
  font-weight 100
  color var(--disabled-color)
  line-height 1
  opacity 0.7
  transition font-size 0.2s ease

  &:hover
    cursor default
    opacity 1

// Small size media item
.smallMediaItem
  width 100%
  min-height 56px
  aspect-ratio 1
  overflow hidden
  border-radius 0

  .placeholder
    .placeholderIcon
      font-size 18px
      font-weight 100
      line-height 24px
      opacity 0.8

    &:hover
      .placeholderIcon
        font-size 24px
        cursor default
        opacity 1

  &.first
    border-bottom-left-radius var(--border-radius)

  &.last
    border-bottom-right-radius var(--border-radius)

  @media (min-width $mobile-width)
    height 80px // ← Фиксированная высота вместо min-height
