.media
  max-width 100%
  max-height 100%
  object-fit contain
  border-radius 8px
  box-shadow 0 4px 20px rgba(0, 0, 0, 0.5)
  user-select none
  -webkit-user-select none
  -webkit-touch-callout none
  cursor pointer
  transition opacity 1s cubic-bezier(0.4, 0, 0.2, 1), transform 1s cubic-bezier(0.4, 0, 0.2, 1)
  opacity 0
  transform scale(0.8) translate(var(--drag-x, 0), var(--drag-y, 0))

  &:active
    transform scale(0.98) translate(var(--drag-x, 0), var(--drag-y, 0)) !important

  &.isOpen
    opacity 1
    transform scale(1) translate(var(--drag-x, 0), var(--drag-y, 0))
