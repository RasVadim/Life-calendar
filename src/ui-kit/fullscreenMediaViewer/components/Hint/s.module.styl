.closeHint
  position absolute
  bottom 20px
  left 50%
  transform translateX(-50%)
  color rgba(255, 255, 255, 0.7)
  font-size 10px
  text-align center
  pointer-events none
  opacity 0
  transition opacity 1s cubic-bezier(0.4, 0, 0.2, 1)
  animation fadeInOut 2s ease-in-out infinite

@keyframes fadeInOut
  0%, 100%
    opacity 0.7

  50%
    opacity 1
