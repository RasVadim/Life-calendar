@import '../../styles/vars.styl'

.fullscreenContainer
  position fixed
  top 0
  left 0
  right 0
  bottom 0
  width 100vw
  height 100vh
  background-color rgba(0, 0, 0, 0.8)
  z-index 200
  display flex
  flex-direction column
  justify-content center
  align-items center
  opacity 0
  visibility hidden
  transform scale(0.9)
  animation 0.3s showFullscreen cubic-bezier(0.4, 0, 0.2, 1)
  animation-fill-mode forwards
  will-change transform, opacity
  backdrop-filter blur(10px)
  -webkit-backdrop-filter blur(10px)

  &.isOpen
    opacity 1
    visibility visible
    transform scale(1)

.hidden
  animation 0.3s hideFullscreen cubic-bezier(0.4, 0, 0.2, 1)
  animation-fill-mode forwards
  pointer-events none

.mediaWrapper
  position relative
  width 100%
  height 100%
  display flex
  justify-content center
  align-items center
  padding 0
  box-sizing border-box

.actionButtons
  position absolute
  bottom 0
  width 100%
  padding 15px
  display flex
  justify-content space-between
  gap 8px
  z-index 10

.actionButton
  background-color var(--background-front-color)
  opacity 0.5

  svg
    stroke var(--contrast-color)

    path
      stroke var(--contrast-color)

.closeHint
  position absolute
  bottom 20px
  left 50%
  transform translateX(-50%)
  color rgba(255, 255, 255, 0.7)
  font-size 10px
  text-align center
  pointer-events none
  opacity 0
  transition opacity 1s cubic-bezier(0.4, 0, 0.2, 1)
  animation fadeInOut 2s ease-in-out infinite

.fullscreenContainer.isOpen .closeHint
  opacity 1

@keyframes fadeInOut
  0%, 100%
    opacity 0.7

  50%
    opacity 1

@keyframes showFullscreen
  from
    opacity 0
    transform scale(0.9)

  to
    opacity 1
    transform scale(1)

@keyframes hideFullscreen
  from
    opacity 1
    transform scale(1)

  to
    opacity 0
    transform scale(0.9)

// Mobile optimizations
@media (min-width $medium-width)
  .mediaWrapper
    padding 20px

  .actionButtons
    padding 25px 40px
    gap 12px
    justify-content right

// Prevent scrolling on body when fullscreen is open
body.fullscreen-open
  overflow hidden
  position fixed
  width 100%
