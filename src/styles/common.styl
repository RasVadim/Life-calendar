@import './fonts.styl'
@import './colors.styl'
@import './vars.styl'

body
  margin 0
  padding 0
  font-family 'Montserrat', sans-serif

  #gradient
    background linear-gradient(0deg, var(--background-g-color) 0%, var(--background-color) 100%)
    position fixed
    top 0
    left 0
    width 100vw
    height 100vh

*
  -webkit-tap-highlight-color rgba(0, 0, 0, 0)