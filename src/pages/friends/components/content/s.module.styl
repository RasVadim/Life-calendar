@import '../../../../styles/vars.styl'

.content
  height 100dvh
  position relative
  display flex
  align-items center
  justify-content center
  padding 0 24px

.placeholder
  display flex
  flex-direction column
  align-items center
  gap 8px
  text-align center

.title
  color var(--text-color)
  font-size 20px
  font-weight 600

.text
  color var(--secondary-color)
  font-size 14px
  font-weight 300
  max-width 320px
