.pixiContainer
  width 100%
  height 100dvh
  max-width 532px
  position absolute
  top 0
  left 0
  right 0
  bottom 0
  overflow hidden
  margin 0 auto

  @media (min-height 1000px)
    max-width 585px

  @media (min-height 1100px)
    max-width 744px

  @media (min-height 1500px)
    max-width 1111px

// Transparent native scroller overlaying the canvas — reuses browser
// momentum / rubber-band; its scrollTop drives the pixi week container.
.scroller
  position absolute
  inset 0
  overflow-y auto
  overflow-x hidden
  overscroll-behavior contain
  -webkit-overflow-scrolling touch
  touch-action pan-y
  scrollbar-width none

  &::-webkit-scrollbar
    display none

.scrollSpacer
  width 1px
  height 0

// Wide-screen year labels: an unclipped overlay centred exactly like the canvas
// (same max-widths), so its children can spill into the free left margin without
// touching the grid. Purely decorative — never intercepts pointer events.
.yearLabels
  position absolute
  top 0
  left 0
  right 0
  bottom 0
  max-width 532px
  margin 0 auto
  pointer-events none
  z-index 2

  @media (min-height 1000px)
    max-width 585px

  @media (min-height 1100px)
    max-width 744px

  @media (min-height 1500px)
    max-width 1111px

// Shared look for both gutter labels; only the horizontal anchoring differs.
.yearLabelStart
.yearLabelEnd
  position absolute
  width 92px
  transform translateY(-50%)
  white-space nowrap
  color var(--text-secondary)
  font-size 11px
  font-weight 300
  pointer-events none

// Start year — left gutter, hugging the grid's left edge.
.yearLabelStart
  left 0
  margin-left -100px
  text-align right

// End year — right gutter, hugging the grid's right edge.
.yearLabelEnd
  right 0
  margin-right -100px
  text-align left