.pixiContainer
  width 100%
  height 100dvh
  max-width 532px
  position absolute
  top 0
  left 0
  right 0
  bottom 0
  overflow hidden
  margin 0 auto

  @media (min-height 1000px)
    max-width 585px

  @media (min-height 1100px)
    max-width 744px

  @media (min-height 1500px)
    max-width 1111px

// Transparent native scroller overlaying the canvas — reuses browser
// momentum / rubber-band; its scrollTop drives the pixi week container.
.scroller
  position absolute
  inset 0
  overflow-y auto
  overflow-x hidden
  overscroll-behavior contain
  -webkit-overflow-scrolling touch
  touch-action pan-y
  scrollbar-width none

  &::-webkit-scrollbar
    display none

.scrollSpacer
  width 1px
  height 0